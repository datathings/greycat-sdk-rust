@library("std", "7.4.10-dev");
@library("csv2");

@volatile
type Record {
    subFamily: String;
    AMRef: String?;
    weightUnit: String;
    _id: String;
    engineType: String;
    firstRegistrationDate: String;
    engineCode: String;
    code: String;
    color: String;
    galaxyCode: String;
    __v: String;
    comments: String;
    Ktype: String;
    phase: String;
    registration: String;
    OERef: String;
    doors: String?;
    VIN: String;
    model: String;
    boxType: String;
    label: String;
    policeNb: String?;
    brand: String;
    quality: String;
    valorisoftProductId: String?;
    year: String;
    specialColorName: String?;
    lueRef: String?;
    boxCode: String?;
    @precision(0.01)
    exVatPrice: float?;
    version: String;
    storage: String;
    PRECode: String;
    colorCode: String;
    @precision(0.01)
    shippingCost: float?;
    energy: String;
    family: String;
    weight: String?;
    mileage: String?;
    images: Array<String>;
}

fn main() {
    var reader = csv2::CsvReader<Record> {
        path: "files/capnor_stock_part.csv",
    };

    while (reader.can_read()) {
        var record = reader.read();
        println(record);
    }
}
