@library("csv2");

@volatile
private type Record {
  mandt: int;
  id: int;
  time: time;
  values: Array<int>;
}

fn main() {
  var reader = csv2::CsvReader<Record> {
    path: "/path/to/file.csv",
    // format: CsvFormat { header_lines: 1 },
  };

  var start = time::now();
  var n = 0;
  while (reader.can_read()) {
    var record = reader.read();
    n = n + 1;
    // println(record);
  }
  println("${n} records in ${time::now() - start}");
}